<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Increase HTTP timeout to handle slow/intermittent network in CI -->
    <add key="http_timeout" value="600" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
