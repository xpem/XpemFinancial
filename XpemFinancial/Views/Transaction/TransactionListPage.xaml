<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="XpemFinancial.Views.Transaction.TransactionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Components="clr-namespace:XpemFinancial.Components"
    xmlns:Icons="clr-namespace:XpemFinancial.Resources"
    xmlns:Utils="clr-namespace:XpemFinancial.Utils"
    xmlns:dto="clr-namespace:Model.DTO;assembly=Model"
    xmlns:vms="clr-namespace:XpemFinancial.VMs.Transaction"
    x:DataType="vms:TransactionListVM"
    Shell.FlyoutBehavior="Flyout">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label
                FontFamily="Icons"
                FontSize="17"
                Text="{x:Static Icons:IconFont.ListCheck}"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
            <Label
                FontSize="17"
                Text="Transações"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Utils:AmountToColorConverter x:Key="AmountToColorConverter" />
            <Utils:IsRecurringConverter x:Key="IsRecurringConverter" />
            <Utils:IsFutureDateConverter x:Key="IsFutureDateConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <!--  Navigation and Period Display  -->
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Margin="0,0,0,0">
                    <Button Command="{Binding LoadPreviousPeriodCommand}" Style="{StaticResource NavButton}">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="Icons"
                                Glyph="{x:Static Icons:IconFont.CaretLeft}"
                                Size="20" />
                        </Button.ImageSource>
                    </Button>
                    <Border Style="{StaticResource FieldBorder}" Margin="5,0">
                        <Label
                            Margin="10"
                            HeightRequest="20"
                            Text="{Binding MonthYearDisplay}"
                            TextColor="{StaticResource FontLight}" />
                    </Border>
                    <Button Command="{Binding LoadNextPeriodCommand}" Style="{StaticResource NavButton}">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="Icons"
                                Glyph="{x:Static Icons:IconFont.CaretRight}"
                                Size="20" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>

                <!--  Filter Toggle Button  -->
                <Button
                    Grid.Column="1"
                    BorderColor="{StaticResource BorderMuted}"
                    BorderWidth="1"
                    Command="{Binding ToggleFiltersCommand}"
                    CornerRadius="5"
                    Style="{StaticResource NavButton}">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding ShowFilters}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource FontMuted}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding ShowFilters}"
                            TargetType="Button"
                            Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="Icons"
                            Glyph="{x:Static Icons:IconFont.Filter}"
                            Size="20"
                            Color="{StaticResource FontLight}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <!--  Loading indicator  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Income}" />

            <!--  Search Filters  -->
            <Border Padding="10" IsVisible="{Binding ShowFilters}">
                <VerticalStackLayout Spacing="10">
                    <!--  Search by Description  -->
                    <Entry
                        Placeholder="Buscar por descrição..."
                        PlaceholderColor="{StaticResource FontMuted}"
                        Text="{Binding SearchDescription}"
                        TextColor="{StaticResource FontLight}" />

                    <!--  Category Picker  -->
                    <Picker
                        Title="Filtrar por Categoria"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding AvailableCategories}"
                        SelectedItem="{Binding SelectedCategory}"
                        TextColor="{StaticResource FontLight}"
                        TitleColor="{StaticResource FontMuted}" />

                    <!--  Income/Expense Filters  -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Components:LabeledCheckBox
                            Color="{StaticResource Income}"
                            IsChecked="{Binding FilterIncomeOnly}"
                            Text="Apenas Entradas" />
                        <Components:LabeledCheckBox
                            Grid.Column="1"
                            Color="{StaticResource Expense}"
                            IsChecked="{Binding FilterExpenseOnly}"
                            Text="Apenas Saídas" />
                    </Grid>

                    <!--  Action Buttons  -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button
                            Grid.Column="1"
                            BackgroundColor="{StaticResource FontMuted}"
                            Command="{Binding ClearFiltersCommand}"
                            Text="Limpar Filtros"
                            TextColor="White">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="Icons"
                                    Glyph="{x:Static Icons:IconFont.Xmark}"
                                    Size="20"
                                    Color="{StaticResource FontLight}" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Transaction List  -->
            <Grid RowDefinitions="Auto, *">

                <!--  Header with count and export button  -->
                <Grid
                    Padding="10"
                    BackgroundColor="{StaticResource HeaderBackground}"
                    ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Transações"
                            TextColor="{StaticResource FontLight}"
                            VerticalOptions="Center" />
                        <Label
                            FontSize="16"
                            Text="{Binding FilteredTransactions.Count, StringFormat='({0})'}"
                            TextColor="{StaticResource FontMuted}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!--  Export Button  -->
                    <Button
                        Grid.Column="1"
                        BackgroundColor="{StaticResource Income}"
                        Command="{Binding ExportToCsvCommand}"
                        CornerRadius="5"
                        FontSize="12"
                        HeightRequest="35"
                        Text="Exportar CSV"
                        TextColor="Black">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="Icons"
                                Glyph="{x:Static Icons:IconFont.FileExport}"
                                Size="14"
                                Color="Black" />
                        </Button.ImageSource>
                    </Button>
                </Grid>

                <!--  List  -->
                <CollectionView
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    ItemsSource="{Binding FilteredTransactions}"
                    SelectedItem="{Binding SelectedTransaction}"
                    SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:TransactionDTO">
                            <Border Margin="5" Padding="10">
                                <Grid
                                    ColumnDefinitions="*, Auto"
                                    RowDefinitions="Auto, Auto, Auto"
                                    RowSpacing="5">

                                    <!--  Description  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Description}"
                                        TextColor="{StaticResource FontLight}" />

                                    <!--  Amount and Recurring Icon  -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding Amount, StringFormat='{0:N2}'}"
                                            TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"
                                            VerticalOptions="Center" />
                                        <Image
                                            HeightRequest="14"
                                            IsVisible="{Binding RecurringRuleId, Converter={StaticResource IsRecurringConverter}}"
                                            VerticalOptions="Center"
                                            WidthRequest="14">
                                            <Image.Source>
                                                <FontImageSource
                                                    FontFamily="Icons"
                                                    Glyph="{x:Static Icons:IconFont.ArrowsRotate}"
                                                    Size="14"
                                                    Color="{StaticResource Transfer}" />
                                            </Image.Source>
                                        </Image>
                                    </HorizontalStackLayout>

                                    <!--  Date and Category  -->
                                    <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                        <Label
                                            FontAttributes="{Binding Date, Converter={StaticResource IsFutureDateConverter}}"
                                            FontSize="13"
                                            Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                            TextColor="{StaticResource FontMuted}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding Category.Name}"
                                            TextColor="{StaticResource Transfer}" />
                                    </HorizontalStackLayout>

                                    <!--  Account Name (if multiple)  -->
                                    <Label
                                        Grid.Row="2"
                                        FontAttributes="Italic"
                                        FontSize="11"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vms:TransactionListVM}}, Path=HasMultipleAccounts}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Account.Name}"
                                        TextColor="{StaticResource FontMuted}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Margin="20"
                            HorizontalOptions="Center"
                            Spacing="10">
                            <Label
                                FontSize="40"
                                HorizontalOptions="Center"
                                Text="📋"
                                TextColor="{StaticResource FontMuted}" />
                            <Label
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Nenhuma transação encontrada para os filtros selecionados."
                                TextColor="{StaticResource FontMuted}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </Grid>

            <!--  Floating Action Button  -->
            <Button
                Margin="0,10,0,0"
                BackgroundColor="{StaticResource Income}"
                Command="{Binding GoToNewTransactionCommand}"
                CornerRadius="25"
                HeightRequest="50"
                HorizontalOptions="End"
                WidthRequest="50">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="Icons"
                        Glyph="{x:Static Icons:IconFont.Plus}"
                        Size="24"
                        Color="White" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
