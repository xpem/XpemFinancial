<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="XpemFinancial.Views.ChartPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Icons="clr-namespace:XpemFinancial.Resources"
    xmlns:Components="clr-namespace:XpemFinancial.Components"
    xmlns:Utils="clr-namespace:XpemFinancial.Utils"
    xmlns:dto="clr-namespace:Model.DTO;assembly=Model"
    xmlns:vms="clr-namespace:XpemFinancial.VMs"
    x:DataType="vms:ChartVM"
    Shell.FlyoutBehavior="Flyout">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label
                FontFamily="Icons"
                FontSize="17"
                Text="{x:Static Icons:IconFont.ChartColumn}"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
            <Label
                FontSize="17"
                Text="Gráfico"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Utils:AmountToColorConverter x:Key="AmountToColorConverter" />
            <Utils:IsRecurringConverter x:Key="IsRecurringConverter" />
            <Utils:IsFutureDateConverter x:Key="IsFutureDateConverter" />
            <Utils:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Margin="0">
        <VerticalStackLayout Padding="10" Spacing="10">

            <FlexLayout
                AlignItems="Center"
                JustifyContent="SpaceBetween"
                Wrap="Wrap">
                <HorizontalStackLayout Margin="0,5,10,5">
                    <Button Command="{Binding LoadPreviousPeriodCommand}" Style="{StaticResource NavButton}">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="Icons"
                                Glyph="{x:Static Icons:IconFont.CaretLeft}"
                                Size="20" />
                        </Button.ImageSource>
                    </Button>
                    <Border Style="{StaticResource FieldBorder}" Margin="5,0">
                        <Label
                            Margin="10"
                            HeightRequest="20"
                            Text="{Binding MonthYearDisplay}"
                            TextColor="{StaticResource FontLight}" />
                    </Border>
                    <Button Command="{Binding LoadNextPeriodCommand}" Style="{StaticResource NavButton}">
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="Icons"
                                Glyph="{x:Static Icons:IconFont.CaretRight}"
                                Size="20" />
                        </Button.ImageSource>
                    </Button>
                </HorizontalStackLayout>
                <Border
                    Margin="0,5"
                    Padding="0"
                    Style="{StaticResource FieldBorder}">
                    <HorizontalStackLayout Spacing="0">
                    <Button
                        Command="{Binding SetScopeCommand}"
                        CommandParameter="{x:Boolean False}"
                        Style="{StaticResource ScopeButton}"
                        Text="Mensal">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsAnnualMode}"
                                TargetType="Button"
                                Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <BoxView Color="{StaticResource BorderMuted}" WidthRequest="1" />
                    <Button
                        Command="{Binding SetScopeCommand}"
                        CommandParameter="{x:Boolean True}"
                        Style="{StaticResource ScopeButton}"
                        Text="Anual">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsAnnualMode}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    </HorizontalStackLayout>
                </Border>
            </FlexLayout>

            <!--  Loading indicator  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Income}" />

            <!--  Include previous balance (monthly mode only)  -->
            <Components:LabeledCheckBox
                IsChecked="{Binding IncludePreviousBalance}"
                IsVisible="{Binding IsAnnualMode, Converter={StaticResource InvertedBoolConverter}}"
                Text="Incluir saldo anterior" />

            <!--  Accumulated vs month-by-month (annual mode only)  -->
            <Components:LabeledCheckBox
                IsChecked="{Binding IsAnnualCumulative}"
                IsVisible="{Binding IsAnnualMode}"
                Text="Valores acumulados" />

            <Border>
                <!--  Chart canvas  -->
                <GraphicsView
                    x:Name="ChartCanvas"
                    HeightRequest="320"
                    HorizontalOptions="Fill"
                    SemanticProperties.Description="{Binding ChartSummary}" />
            </Border>
            <!--  Legend: income = solid line, expense = dashed line  -->
            <HorizontalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="6">
                    <Line
                        Stroke="{StaticResource Income}"
                        StrokeThickness="2"
                        VerticalOptions="Center"
                        WidthRequest="20"
                        X1="0"
                        X2="20" />
                    <Label
                        FontSize="12"
                        Text="{Binding IncomeLegend}"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Line
                        Stroke="{StaticResource Expense}"
                        StrokeDashArray="3,2"
                        StrokeThickness="2"
                        VerticalOptions="Center"
                        WidthRequest="20"
                        X1="0"
                        X2="20" />
                    <Label
                        FontSize="12"
                        Text="{Binding ExpenseLegend}"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <!--  Top 10 Maiores Despesas  -->
            <Border Padding="0">
                <Grid RowDefinitions="Auto, *">

                    <!--  Header  -->
                    <Label
                        Padding="10"
                        BackgroundColor="{StaticResource HeaderBackground}"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Top 10 Maiores Despesas"
                        TextColor="{StaticResource FontLight}" />

                    <!--  List  -->
                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding TopExpenses}"
                        SelectedItem="{Binding SelectedTransaction}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:TransactionDTO">
                                <Grid
                                    Padding="10,8"
                                    ColumnDefinitions="2*, 1.2*, 1*, Auto"
                                    RowDefinitions="Auto, Auto, 1"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Description}"
                                        TextColor="{StaticResource FontLight}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="{Binding Date, Converter={StaticResource IsFutureDateConverter}}"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Date, StringFormat='{0:dd/MM}'}"
                                        TextColor="{StaticResource FontLight}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding Amount, StringFormat='{0:N2}'}"
                                        TextColor="{Binding Amount, Converter={StaticResource AmountToColorConverter}}"
                                        VerticalOptions="Center" />
                                    <Image
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        HeightRequest="12"
                                        IsVisible="{Binding RecurringRuleId, Converter={StaticResource IsRecurringConverter}}"
                                        VerticalOptions="Center"
                                        WidthRequest="12">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="Icons"
                                                Glyph="{x:Static Icons:IconFont.ArrowsRotate}"
                                                Size="12"
                                                Color="{StaticResource Transfer}" />
                                        </Image.Source>
                                    </Image>

                                    <!--  Source account name: shown when user has multiple accounts  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="4"
                                        Margin="5,0,0,0"
                                        FontAttributes="Italic"
                                        FontSize="11"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vms:ChartVM}}, Path=HasMultipleAccounts}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Account.Name}"
                                        TextColor="{StaticResource FontMuted}"
                                        VerticalOptions="Start" />

                                    <BoxView
                                        Grid.Row="2"
                                        Grid.ColumnSpan="4"
                                        Margin="0,8,0,-8"
                                        Color="{StaticResource HeaderBackground}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                Margin="20"
                                HorizontalOptions="Center"
                                Text="Nenhuma despesa encontrada para o período selecionado."
                                TextColor="{StaticResource FontMuted}" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
