<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="XpemFinancial.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Components="clr-namespace:XpemFinancial.Components"
    xmlns:Icons="clr-namespace:XpemFinancial.Resources"
    xmlns:Utils="clr-namespace:XpemFinancial.Utils"
    xmlns:ViewModels="clr-namespace:XpemFinancial.VMs"
    xmlns:dto="clr-namespace:Model.DTO;assembly=Model"
    x:DataType="ViewModels:MainVM"
    Shell.FlyoutBehavior="Flyout">
    <Shell.TitleView>
        <HorizontalStackLayout
            FlowDirection="RightToLeft"
            HorizontalOptions="End"
            Spacing="8"
            VerticalOptions="Center">
            <Button
                BackgroundColor="{StaticResource Transfer}"
                Command="{Binding GoToNewTransactionCommand}"
                CommandParameter="{x:Static dto:TransactionType.Transfer}"
                IsEnabled="{Binding IsNotNullAccount}"
                Style="{StaticResource SuccessButton}">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="Icons"
                        Glyph="{x:Static Icons:IconFont.RightLeft}"
                        Size="13"
                        Color="White" />
                </Button.ImageSource>
            </Button>
            <Button
                BackgroundColor="{StaticResource Income}"
                Command="{Binding GoToNewTransactionCommand}"
                CommandParameter="{x:Static dto:TransactionType.Income}"
                IsEnabled="{Binding IsNotNullAccount}"
                Style="{StaticResource SuccessButton}">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="Icons"
                        Glyph="{x:Static Icons:IconFont.ArrowTrendUp}"
                        Size="13"
                        Color="White" />
                </Button.ImageSource>
            </Button>
            <Button
                Margin="10,0,10,0"
                BackgroundColor="{StaticResource Expense}"
                Command="{Binding GoToNewTransactionCommand}"
                CommandParameter="{x:Static dto:TransactionType.Expense}"
                IsEnabled="{Binding IsNotNullAccount}"
                Style="{StaticResource SuccessButton}">
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="Icons"
                        Glyph="{x:Static Icons:IconFont.ArrowTrendDown}"
                        Size="13"
                        Color="White" />
                </Button.ImageSource>
            </Button>
        </HorizontalStackLayout>
    </Shell.TitleView>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Utils:AmountToColorConverter x:Key="AmountToColorConverter" />
            <Utils:IsRecurringConverter x:Key="IsRecurringConverter" />
            <Utils:IsFutureDateConverter x:Key="IsFutureDateConverter" />
            <Utils:IsTransferConverter x:Key="IsTransferConverter" />
            <Utils:IsNotNullConverter x:Key="IsNotNullConverter" />
            <Utils:TransactionAmountColorConverter x:Key="TransactionAmountColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView Margin="0">
        <VerticalStackLayout Padding="5">
            <Grid IsVisible="{Binding IsNullAccount}">
                <Border
                    Margin="10"
                    Padding="10"
                    Stroke="{StaticResource Income}">
                    <StackLayout>
                        <Label Margin="0,0,0,10" Text="Defina um valor inicial para a sua conta antes de inserir sua primeira transação" />
                        <Button
                            Command="{Binding GoToAccountPageCommand}"
                            HorizontalOptions="Start"
                            Style="{StaticResource EditButtonOutline}"
                            Text="Ajustar Saldo Inicial">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="Icons"
                                    Glyph="{x:Static Icons:IconFont.Wallet}"
                                    Size="15"
                                    Color="{StaticResource UpdateAction}" />
                            </Button.ImageSource>
                        </Button>
                    </StackLayout>
                </Border>
            </Grid>
            <HorizontalStackLayout Margin="5,0,5,10">
                <Button
                    x:Name="PreviousMonthButton"
                    Command="{Binding LoadPreviousMonthCommand}"
                    Style="{StaticResource NavButton}">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="Icons"
                            Glyph="{x:Static Icons:IconFont.CaretLeft}"
                            Size="20" />
                    </Button.ImageSource>
                </Button>
                <Border
                    Margin="5,0,5,0"
                    Padding="0"
                    Style="{StaticResource FieldBorder}">
                    <Picker
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        ItemsSource="{Binding MonthOptions}"
                        SelectedItem="{Binding SelectedMonthOption}"
                        TextColor="{StaticResource FontLight}" />
                </Border>
                <Button
                    x:Name="NextMonthButton"
                    Command="{Binding LoadNextMonthCommand}"
                    Style="{StaticResource NavButton}">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="Icons"
                            Glyph="{x:Static Icons:IconFont.CaretRight}"
                            Size="20" />
                    </Button.ImageSource>
                </Button>

            </HorizontalStackLayout>
            <Border Margin="0" Padding="0">
                <Grid RowDefinitions="Auto, *,*">
                    <!--  Header Section  -->
                    <Label
                        Padding="10"
                        BackgroundColor="{StaticResource HeaderBackground}"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Entradas e saídas"
                        TextColor="{StaticResource FontLight}" />
                    <!--  Content Section  -->
                    <Components:LabeledCheckBox
                        Grid.Row="1"
                        IsChecked="{Binding IncludePreviousBalance}"
                        Text="Incluir saldo anterior" />
                    <Grid
                        Grid.Row="2"
                        Padding="5"
                        ColumnDefinitions="*, *"
                        HorizontalOptions="Fill"
                        RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                        <Label
                            FontAttributes="Bold"
                            IsVisible="{Binding IncludePreviousBalance}"
                            Text="Saldo anterior"
                            TextColor="{StaticResource FontLight}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Column="1"
                            FontSize="22"
                            HorizontalOptions="End"
                            IsVisible="{Binding IncludePreviousBalance}"
                            Text="{Binding PreviousBalance, StringFormat='{}{0:N2}'}"
                            TextColor="{StaticResource Transfer}" />

                        <Label
                            Grid.Row="1"
                            FontAttributes="Bold"
                            Text="Entradas"
                            TextColor="{StaticResource Income}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="22"
                            HorizontalOptions="End"
                            Text="{Binding Income, StringFormat='{}{0:N2}'}"
                            TextColor="{StaticResource Income}" />
                        <Label
                            Grid.Row="2"
                            FontAttributes="Bold"
                            Text="Saídas"
                            TextColor="{StaticResource FontLight}"
                            VerticalTextAlignment="Center" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="22"
                            HorizontalOptions="End"
                            Text="{Binding Expense, StringFormat='{}{0:N2}'}"
                            TextColor="{StaticResource Expense}" />

                        <BoxView
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,10"
                            BackgroundColor="{StaticResource Transfer}"
                            HeightRequest="1" />
                        <Label
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            FontAttributes="Bold"
                            FontSize="22"
                            HorizontalOptions="End"
                            Text="{Binding Total, StringFormat='{}{0:N2}'}"
                            TextColor="{StaticResource FontLight}"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0" Padding="0">
                <Grid RowDefinitions="Auto, *">
                    <Grid BackgroundColor="{StaticResource HeaderBackground}">
                        <Label
                            Grid.ColumnSpan="3"
                            Padding="10"
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Start"
                            Text="Transações"
                            TextColor="{StaticResource FontLight}" />
                    </Grid>
                    <CollectionView
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        ItemsSource="{Binding Transactions}"
                        SelectedItem="{Binding SelectedTransaction}"
                        SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:TransactionDTO">
                                <Grid
                                    Padding="5,0,5,0"
                                    ColumnDefinitions="2*, 1.2*, 1*, Auto"
                                    RowDefinitions="Auto, Auto"
                                    RowSpacing="0"
                                    VerticalOptions="Center">
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Description}"
                                        TextColor="{StaticResource FontLight}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="{Binding Date, Converter={StaticResource IsFutureDateConverter}}"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Date, StringFormat='{0:dd/MM}'}"
                                        TextColor="{StaticResource FontLight}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding Amount, StringFormat='{0:N2}'}">
                                        <Label.TextColor>
                                            <MultiBinding Converter="{StaticResource TransactionAmountColorConverter}">
                                                <Binding Path="Amount" />
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.TextColor>
                                        <Label.VerticalOptions>
                                            <LayoutOptions Alignment="Center" />
                                        </Label.VerticalOptions>
                                    </Label>

                                    <!--  Transfer indicator: shown when Type == Transfer  -->
                                    <Image
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        HeightRequest="12"
                                        IsVisible="{Binding Type, Converter={StaticResource IsTransferConverter}}"
                                        VerticalOptions="Center"
                                        WidthRequest="12">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="Icons"
                                                Glyph="{x:Static Icons:IconFont.RightLeft}"
                                                Size="12"
                                                Color="{StaticResource Transfer}" />
                                        </Image.Source>
                                    </Image>

                                    <!--  Recurring indicator: shown when RecurringRuleId != null  -->
                                    <Image
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        HeightRequest="12"
                                        IsVisible="{Binding RecurringRuleId, Converter={StaticResource IsRecurringConverter}}"
                                        VerticalOptions="Center"
                                        WidthRequest="12">
                                        <Image.Source>
                                            <FontImageSource
                                                FontFamily="Icons"
                                                Glyph="{x:Static Icons:IconFont.ArrowsRotate}"
                                                Size="12"
                                                Color="{StaticResource Transfer}" />
                                        </Image.Source>
                                    </Image>

                                    <!--  Destination account name: shown for transfers with a destination account  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="4"
                                        FontSize="11"
                                        IsVisible="{Binding DestinationAccount, Converter={StaticResource IsNotNullConverter}}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding DestinationAccount.Name, StringFormat='→ {0}'}"
                                        TextColor="{StaticResource FontMuted}"
                                        VerticalOptions="Start" />

                                    <!--  Source account name: shown when user has multiple accounts (non-transfer)  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="4"
                                        Margin="5,0,0,0"
                                        FontAttributes="Italic"
                                        FontSize="11"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:MainVM}}, Path=HasMultipleAccounts}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Account.Name}"
                                        TextColor="{StaticResource FontMuted}"
                                        VerticalOptions="Start">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding DestinationAccount, Converter={StaticResource IsNotNullConverter}}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label
                                Margin="20"
                                HorizontalOptions="Center"
                                Text="Nenhuma transação encontrada."
                                TextColor="{StaticResource FontMuted}" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
