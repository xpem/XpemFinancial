<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="XpemFinancial.Views.AveragesProjectionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Components="clr-namespace:XpemFinancial.Components"
    xmlns:Icons="clr-namespace:XpemFinancial.Resources"
    xmlns:Utils="clr-namespace:XpemFinancial.Utils"
    xmlns:vms="clr-namespace:XpemFinancial.VMs"
    x:DataType="vms:AveragesProjectionsVM"
    Shell.FlyoutBehavior="Flyout">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Label
                FontFamily="Icons"
                FontSize="17"
                Text="{x:Static Icons:IconFont.ChartLine}"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
            <Label
                FontSize="17"
                Text="Médias e Projeções"
                TextColor="{StaticResource White}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Utils:AmountToColorConverter x:Key="AmountToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Margin="0">
        <VerticalStackLayout Padding="10" Spacing="10">

            <Label
                FontSize="13"
                Text="{Binding SubtitleText}"
                TextColor="{StaticResource BorderMuted}" />

            <!--  Loading indicator  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Income}" />

            <!--  Stat tiles: Entrada média / Saída média / Saldo médio  -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="12"
                            Text="Entrada média"
                            TextColor="{StaticResource BorderMuted}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding AverageIncome, StringFormat='{0:N2}'}"
                            TextColor="{StaticResource Income}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="12"
                            Text="Saída média"
                            TextColor="{StaticResource BorderMuted}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding AverageExpense, StringFormat='{0:N2}'}"
                            TextColor="{StaticResource Expense}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            FontSize="12"
                            Text="Saldo médio"
                            TextColor="{StaticResource BorderMuted}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding AverageBalance, StringFormat='{0:N2}'}"
                            TextColor="{Binding AverageBalance, Converter={StaticResource AmountToColorConverter}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border>
                <!--  Chart canvas  -->
                <GraphicsView
                    x:Name="ChartCanvas"
                    HeightRequest="320"
                    HorizontalOptions="Fill"
                    SemanticProperties.Description="{Binding ChartSummary}" />
            </Border>

            <!--  Legend  -->
            <HorizontalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="6">
                    <Grid
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Line
                            Stroke="{StaticResource Income}"
                            StrokeThickness="2"
                            VerticalOptions="Center"
                            X1="0"
                            X2="20" />
                        <Ellipse
                            Fill="{StaticResource Income}"
                            HeightRequest="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="6" />
                    </Grid>
                    <Label
                        FontSize="12"
                        Text="Entradas"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Grid
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Line
                            Stroke="{StaticResource Expense}"
                            StrokeThickness="2"
                            VerticalOptions="Center"
                            X1="0"
                            X2="20" />
                        <Rectangle
                            Fill="{StaticResource Expense}"
                            HeightRequest="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="6" />
                    </Grid>
                    <Label
                        FontSize="12"
                        Text="Saídas"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Border
                        BackgroundColor="Transparent"
                        HeightRequest="14"
                        Padding="0"
                        Stroke="{StaticResource UpdateAction}"
                        StrokeShape="RoundRectangle 7"
                        StrokeThickness="2"
                        VerticalOptions="Center"
                        WidthRequest="14"/>
                    <Label
                        FontSize="12"
                        Text="Fora do padrão"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout IsVisible="{Binding IsScenarioActive}" Spacing="6">
                    <Grid
                        HeightRequest="10"
                        VerticalOptions="Center"
                        WidthRequest="20">
                        <Line
                            Stroke="{StaticResource Transfer}"
                            StrokeThickness="2"
                            VerticalOptions="Center"
                            X1="0"
                            X2="20" />
                        <Ellipse
                            Fill="{StaticResource Transfer}"
                            HeightRequest="6"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="6" />
                    </Grid>
                    <Label
                        FontSize="12"
                        Text="Cenário simulado"
                        TextColor="{StaticResource FontLight}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>

            <Label
                FontAttributes="Italic"
                FontSize="11"
                Text="Linha pontilhada grossa = projeção baseada na mediana. Linha pontilhada fina = nível típico (mediana) dos últimos 6 meses, para comparar com os valores reais."
                TextColor="{StaticResource FontMuted}" />

            <!--  Simulação de cenário  -->
            <Border Padding="10">
                <VerticalStackLayout Spacing="10">
                    <Components:LabeledCheckBox
                        FontAttributes="Bold"
                        IsChecked="{Binding IsScenarioActive}"
                        Text="Simular cenário" />

                    <VerticalStackLayout IsVisible="{Binding IsScenarioActive}" Spacing="10">
                        <Border
                            HorizontalOptions="Start"
                            Padding="0"
                            Style="{StaticResource FieldBorder}">
                            <HorizontalStackLayout Spacing="0">
                                <Button
                                    Command="{Binding SetScenarioTargetCommand}"
                                    CommandParameter="{x:Boolean False}"
                                    Style="{StaticResource ScopeButton}"
                                    Text="Entrada">
                                    <Button.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsScenarioExpense}"
                                            TargetType="Button"
                                            Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Income}" />
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <BoxView Color="{StaticResource BorderMuted}" WidthRequest="1" />
                                <Button
                                    Command="{Binding SetScenarioTargetCommand}"
                                    CommandParameter="{x:Boolean True}"
                                    Style="{StaticResource ScopeButton}"
                                    Text="Saída">
                                    <Button.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsScenarioExpense}"
                                            TargetType="Button"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Expense}" />
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontSize="12"
                                Text="Variação mensal (ex.: 1000,00 para um aumento)"
                                TextColor="{StaticResource BorderMuted}" />
                            <Components:CurrencyEntry Text="{Binding ScenarioDeltaText}" />
                        </VerticalStackLayout>

                        <Label
                            FontSize="13"
                            Text="{Binding ScenarioSummary}"
                            TextColor="{StaticResource Transfer}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
