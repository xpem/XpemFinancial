<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="XpemFinancial.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Components="clr-namespace:XpemFinancial.Components"
    xmlns:icons="clr-namespace:XpemFinancial.Resources"
    xmlns:local="clr-namespace:XpemFinancial.Views"
    xmlns:utils="clr-namespace:XpemFinancial.Utils"
    Title="XpemFinancial"
    BackgroundColor="#10151e"
    FlyoutBackgroundColor="{StaticResource PageBackground}"
    FlyoutHeaderBehavior="CollapseOnScroll"
    ForegroundColor="{StaticResource FontLight}"
    Shell.TitleColor="White">

    <Shell.Resources>
        <ResourceDictionary>
            <utils:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid
                ColumnDefinitions="0.2*,0.8*"
                HeightRequest="50"
                HorizontalOptions="Start">
                <Label
                    Margin="10,5,10,5"
                    FontFamily="Icons"
                    FontSize="17"
                    Text="{Binding Icon}"
                    TextColor="{StaticResource White}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="15"
                    Text="{Binding Title}"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutHeader>
        <Components:FlyoutHeader Name="{Binding Name}" Email="{Binding Email}" />
    </Shell.FlyoutHeader>


    <FlyoutItem
        Title="Principal"
        Icon="{x:Static icons:IconFont.House}"
        Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>



    <ShellItem FlyoutItemIsVisible="False" Route="SignInPage">
        <ShellContent ContentTemplate="{DataTemplate local:SignInPage}" />
    </ShellItem>

    <FlyoutItem Title="Contas" Icon="{x:Static icons:IconFont.Wallet}">
        <ShellContent ContentTemplate="{DataTemplate local:Account.AccountsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Categorias" Icon="{x:Static icons:IconFont.Tag}">
        <ShellContent ContentTemplate="{DataTemplate local:CategoryManagementPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Gráfico" Icon="{x:Static icons:IconFont.ChartColumn}">
        <ShellContent ContentTemplate="{DataTemplate local:ChartPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Médias e Projeções" Icon="{x:Static icons:IconFont.ChartLine}">
        <ShellContent ContentTemplate="{DataTemplate local:AveragesProjectionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Transações" Icon="{x:Static icons:IconFont.ListCheck}">
        <ShellContent ContentTemplate="{DataTemplate local:Transaction.TransactionListPage}" />
    </FlyoutItem>

    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <StackLayout>
                <!-- Sync status block -->
                <HorizontalStackLayout
                    Margin="14,8,10,0"
                    Spacing="6">
                    <Label
                        FontFamily="Icons"
                        FontSize="13"
                        IsVisible="{Binding HasSyncError}"
                        Text="{x:Static icons:IconFont.TriangleExclamation}"
                        TextColor="{StaticResource Expense}"
                        VerticalOptions="Center" />
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="12"
                        IsVisible="{Binding HasSyncError}"
                        Text="Falha na sincronização"
                        TextColor="{StaticResource Expense}"
                        VerticalOptions="Center" />
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="12"
                        IsVisible="{Binding LastSyncDate, Converter={StaticResource IsNotNullConverter}}"
                        Text="{Binding LastSyncDate}"
                        TextColor="#aaaaaa"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Button
                    x:Name="BtnSignOut"
                    Margin="10,10,10,10"
                    BackgroundColor="{StaticResource Expense}"
                    Command="{Binding SignOutCommand}"
                    ContentLayout="Left,10"
                    FontSize="15"
                    Style="{StaticResource DeleteButtonOutline}"
                    Text="Sair"
                    TextColor="{StaticResource White}">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="Icons"
                            Glyph="{x:Static icons:IconFont.ArrowRightFromBracket}"
                            Size="12"
                            Color="{StaticResource White}" />
                    </Button.ImageSource>
                </Button>
            </StackLayout>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

</Shell>
