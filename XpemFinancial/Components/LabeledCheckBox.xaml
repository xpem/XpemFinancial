<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="XpemFinancial.Components.LabeledCheckBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">
    <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
        <CheckBox IsChecked="{Binding Source={x:Reference this}, Path=IsChecked}" Color="{Binding Source={x:Reference this}, Path=Color}" />
        <Label
            FontAttributes="{Binding Source={x:Reference this}, Path=FontAttributes}"
            Text="{Binding Source={x:Reference this}, Path=Text}"
            TextColor="{StaticResource FontLight}"
            VerticalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLabelTapped" />
            </Label.GestureRecognizers>
        </Label>
    </HorizontalStackLayout>
</ContentView>
